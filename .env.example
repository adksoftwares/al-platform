# Backend service configuration. Set real values only in your hosting provider's secret store.
PORT=3000
# Set to the exact web origin(s), comma-separated. Do not use '*'.
CORS_ALLOWED_ORIGINS=https://YOUR_WEB_HOST
# Number of trusted reverse-proxy hops; leave 0 unless configured for your host.
TRUST_PROXY_HOPS=0
FIREBASE_DB_URL=https://al-students-default-rtdb.asia-southeast1.firebasedatabase.app
# Set FIREBASE_SERVICE_ACCOUNT to the minified service-account JSON in your secret store.
# Never commit a real service-account JSON or private key.
FIREBASE_SERVICE_ACCOUNT=
PAYHERE_MERCHANT_ID=replace-with-your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=replace-with-your-payhere-merchant-secret
# Used by the quiz-generation workflow only; configure as a GitHub Actions secret.
GEMINI_API_KEY=
