{
  "rules": {
    ".read": false,
    ".write": false,
    "admin_settings": {
      "bank_details": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin == true"
      },
      "payment_config": {
        ".read": "auth != null && auth.token.admin == true",
        ".write": "auth != null && auth.token.admin == true"
      },
      "premium_codes": {
        ".read": false,
        ".write": "auth != null && auth.token.admin == true"
      },
      "app_version": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin == true"
      },
      "github_token": {
        ".read": "auth != null && auth.token.admin == true",
        ".write": "auth != null && auth.token.admin == true",
        ".validate": "newData.isString()"
      },
      "gemini_api_key": {
        ".read": false,
        ".write": "auth != null && auth.token.admin == true"
      },
      "$other": {
        ".read": "auth != null && auth.token.admin == true",
        ".write": "auth != null && auth.token.admin == true"
      }
    },
    "users": {
      ".read": "auth != null && auth.token.admin == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        ".write": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        "isAdmin": {
          ".validate": "(!newData.exists() && !data.exists()) || (newData.val() == data.val())"
        },
        "isPremium": {
          ".validate": "(!data.exists() && newData.val() == false) || (newData.val() == data.val())"
        },
        "premiumExpiry": {
          ".validate": "(!newData.exists() && !data.exists()) || (newData.val() == data.val())"
        },
        "premiumValidUntil": {
          ".validate": "(!newData.exists() && !data.exists()) || (newData.val() == data.val())"
        },
        "freeDownloadsCount": {
          ".validate": "(!data.exists() && newData.val() == 0) || (newData.val() == data.val())"
        },
        "password": {
          ".validate": "(!newData.exists()) || (newData.val() == data.val())"
        }
      }
    },
    "bank_transfers": {
      ".read": "auth != null && auth.token.admin == true",
      "$transferId": {
        ".read": "auth != null && (auth.token.admin == true || data.child('uid').val() == auth.uid)",
        ".write": "auth != null && (auth.token.admin == true || (!data.exists() && newData.child('uid').val() == auth.uid))"
      }
    },
    "suggestions": {
      ".read": "auth != null && auth.token.admin == true",
      "$suggestionId": {
        ".write": "auth != null && auth.token.admin == true",
        ".validate": "auth != null && auth.token.admin == true && newData.hasChildren(['fileName', 'subject', 'folder', 'downloadUrl'])"
      }
    },
    "pending_suggestions": {
      ".read": "auth != null && auth.token.admin == true",
      "$suggestionId": {
        ".write": "auth != null && (auth.token.admin == true || (!data.exists() && (newData.child('uid').val() == auth.uid || newData.child('submittedBy').val() == auth.uid)))",
        ".validate": "auth.token.admin == true || newData.child('uid').val() == auth.uid || newData.child('submittedBy').val() == auth.uid"
      }
    },
    "pending_approvals": {
      ".read": "auth != null && auth.token.admin == true",
      "$approvalId": {
        ".write": "auth != null && (auth.token.admin == true || (!data.exists() && newData.child('userId').val() == auth.uid))",
        ".validate": "auth.token.admin == true || newData.child('userId').val() == auth.uid"
      }
    },
    "daily_quizzes_v4": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },
    "folders": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },
    "files": {
      ".write": "auth != null && auth.token.admin == true",
      "$subject": {
        "elaborations": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.admin == true"
        },
        "past papers": {
          ".read": "auth != null && ((root.child('users').child(auth.uid).child('isPremium').val() == true && (root.child('users').child(auth.uid).child('premiumExpiry').val() > now || root.child('users').child(auth.uid).child('premiumValidUntil').val() > now)) || auth.token.admin == true)",
          ".write": "auth != null && auth.token.admin == true"
        },
        "Notes": {
          ".read": "auth != null && ((root.child('users').child(auth.uid).child('isPremium').val() == true && (root.child('users').child(auth.uid).child('premiumExpiry').val() > now || root.child('users').child(auth.uid).child('premiumValidUntil').val() > now)) || auth.token.admin == true)",
          ".write": "auth != null && auth.token.admin == true"
        }
      }
    }
  }
}
